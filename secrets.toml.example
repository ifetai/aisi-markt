# In Streamlit Community Cloud unter App > Settings > Secrets einfuegen (nicht ins Repo legen).

admin_key = "hier-einen-eigenen-schluessel"
app_url = "https://aisi-markt.streamlit.app/"   # Adresse der App, erscheint im QR-Code

# Optional: Antworten in Google Sheets sichern (gleich wie bei teach-the-machine)
sheet_id = "ID-des-Google-Sheets"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
